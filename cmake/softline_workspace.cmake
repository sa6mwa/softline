include_guard(GLOBAL)

# REAL_PATH needs an existing path. Resolve its existing ancestor before adding
# new cache/build components so a symlink parent cannot escape ownership.
function(softline_physical_path path output)
  set(suffix "")
  while(NOT EXISTS "${path}" AND NOT IS_SYMLINK "${path}")
    get_filename_component(name "${path}" NAME)
    get_filename_component(parent "${path}" DIRECTORY)
    if(parent STREQUAL path)
      message(FATAL_ERROR "Cannot resolve workspace path: ${path}")
    endif()
    set(suffix "/${name}${suffix}")
    set(path "${parent}")
  endwhile()
  file(REAL_PATH "${path}" physical)
  set(physical "${physical}${suffix}")
  cmake_path(NORMAL_PATH physical OUTPUT_VARIABLE physical)
  set(${output} "${physical}" PARENT_SCOPE)
endfunction()

function(softline_check_generated_path root path)
  file(REAL_PATH "${root}" owner)
  softline_physical_path("${path}" selected)
  foreach(area build .cache dist)
    set(base "${owner}/${area}")
    cmake_path(IS_PREFIX base "${selected}" NORMALIZE inside)
    if(inside AND NOT selected STREQUAL base)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "Generated path must stay below this checkout's build/, .cache/ or dist/: ${path}")
endfunction()

# Generated state belongs to this checkout; only the declared global cpkt
# caches may be shared. REAL_PATH also catches symlink parents of overrides.
function(softline_check_workspace root)
  file(REAL_PATH "${root}" owner)
  foreach(area build dist .cache)
    if(IS_SYMLINK "${owner}/${area}")
      message(FATAL_ERROR "${area}/ must be owned by this checkout, not a symlink")
    endif()
  endforeach()
  if(DEFINED CMAKE_BINARY_DIR)
    cmake_path(IS_PREFIX owner "${CMAKE_BINARY_DIR}" NORMALIZE local_build)
    softline_physical_path("${CMAKE_BINARY_DIR}" binary)
    cmake_path(IS_PREFIX owner "${binary}" NORMALIZE owned_build)
    if(local_build AND NOT owned_build)
      message(FATAL_ERROR "Build directory resolves outside this checkout: ${CMAKE_BINARY_DIR}")
    endif()
  endif()
  if(DEFINED ENV{XDG_CACHE_HOME} AND NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
    set(global "$ENV{XDG_CACHE_HOME}/cpkt")
  else()
    set(global "$ENV{HOME}/.cache/cpkt")
  endif()
  foreach(kind TOOLCHAIN DEPENDENCY)
    if(DEFINED CPKT_${kind}_CACHE)
      set(selected "${CPKT_${kind}_CACHE}")
    else()
      set(selected "$ENV{CPKT_${kind}_CACHE}")
    endif()
    if(kind STREQUAL TOOLCHAIN)
      set(shared "${global}/toolchains")
    else()
      set(shared "${global}/deps")
    endif()
    if(selected STREQUAL "" AND SOFTLINE_SHARED_CACHES_ONLY)
      set(selected "${shared}")
    endif()
    if(selected STREQUAL "")
      continue()
    endif()
    if(NOT IS_ABSOLUTE "${selected}")
      message(FATAL_ERROR "CPKT_${kind}_CACHE must be an absolute owned path")
    endif()
    softline_physical_path("${selected}" selected)
    if(SOFTLINE_SHARED_CACHES_ONLY)
      foreach(area build dist .cache)
        set(disposable "${owner}/${area}")
        cmake_path(IS_PREFIX disposable "${selected}" NORMALIZE removed)
        if(removed)
          message(FATAL_ERROR "Release/source reconstruction caches must survive make clean: ${selected}")
        endif()
      endforeach()
    endif()
    set(allowed FALSE)
    foreach(base "${owner}/build" "${owner}/.cache" "${shared}")
      softline_physical_path("${base}" physical)
      cmake_path(IS_PREFIX physical "${selected}" NORMALIZE inside)
      if(inside)
        set(allowed TRUE)
      endif()
    endforeach()
    if(NOT allowed)
      message(FATAL_ERROR "CPKT_${kind}_CACHE must use this checkout's build/ or .cache/, or ${shared}")
    endif()
  endforeach()
endfunction()

if(DEFINED SOFTLINE_WORKSPACE_ROOT)
  softline_check_workspace("${SOFTLINE_WORKSPACE_ROOT}")
  if(DEFINED SOFTLINE_GENERATED_PATH)
    softline_check_generated_path("${SOFTLINE_WORKSPACE_ROOT}" "${SOFTLINE_GENERATED_PATH}")
  endif()
endif()
