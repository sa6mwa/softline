cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/header-doxygen.cmake")
file(READ "${INVENTORY}" facts)
file(READ "${ROOT}/lua/README.md" docs)
file(READ "${ROOT}/README.md" readme)
file(READ "${ROOT}/include/softline/softline.h" header)
file(STRINGS "${ROOT}/cmake/softline.exports" exports)
list(FILTER exports EXCLUDE REGEX "^(#|[ \t]*$)")
function(fact_list key output)
  string(JSON count LENGTH "${facts}" "${key}")
  if(count EQUAL 0)
    message(FATAL_ERROR "Empty API inventory: ${key}")
  endif()
  math(EXPR last "${count}-1")
  set(values)
  foreach(index RANGE ${last})
    string(JSON value GET "${facts}" "${key}" ${index})
    list(APPEND values "${value}")
  endforeach()
  set(${output} "${values}" PARENT_SCOPE)
endfunction()
fact_list(functions functions)
list(SORT functions)
list(SORT exports)
if(NOT functions STREQUAL exports)
  message(FATAL_ERROR "C public declarations and dynamic export allowlist differ")
endif()
fact_list(config config)
fact_list(lua_config lua_config)
fact_list(accepted_config accepted)
list(SORT config)
list(SORT lua_config)
list(SORT accepted)
if(NOT config STREQUAL lua_config OR NOT config STREQUAL accepted)
  message(FATAL_ERROR "C and Lua configuration fields differ")
endif()
foreach(field IN LISTS config)
  string(FIND "${docs}" "`${field}`" documented)
  if(documented EQUAL -1)
    message(FATAL_ERROR "Lua config documentation missing: ${field}")
  endif()
endforeach()
fact_list(lua_methods methods)
foreach(method IN LISTS methods)
  string(FIND "${docs}" "`sl:${method}(" documented)
  if(documented EQUAL -1)
    message(FATAL_ERROR "Lua method documentation missing: ${method}")
  endif()
endforeach()
fact_list(receiver receiver)
set(aliases destroy close prompt_queue_count queue_count prompt_queue_capacity queue_capacity
  prompt_queue_peek queue_peek prompt_queue_insert queue_insert prompt_queue_append queue_append
  prompt_queue_replace queue_replace prompt_queue_take queue_take prompt_queue_get_mode queue_mode
  prompt_queue_set_mode queue_set_mode prompt_queue_clear queue_clear prompt_queue_enqueue_draft queue_draft
  set_prompt_queue_delivery set_queue_delivery get_prompt_queue_delivery queue_delivery
  set_prompt_queue_profile set_queue_profile get_prompt_queue_profile queue_profile
  set_prompt_queue_keys set_queue_keys get_prompt_queue_keys queue_keys)
set(expected)
foreach(method IN LISTS receiver)
  if(method STREQUAL free_string)
    continue()
  endif()
  set(lua_name "${method}")
  list(FIND aliases "${method}" alias_index)
  if(NOT alias_index EQUAL -1)
    math(EXPR alias_index "${alias_index}+1")
    list(GET aliases ${alias_index} lua_name)
  endif()
  list(APPEND expected "${lua_name}")
  if(NOT "sl_${method}" IN_LIST functions)
    message(FATAL_ERROR "Receiver lacks public C counterpart: ${method}")
  endif()
endforeach()
list(SORT expected)
list(SORT methods)
if(NOT expected STREQUAL methods)
  message(FATAL_ERROR "C receiver and Lua method registry differ")
endif()
string(JSON count LENGTH "${facts}" constants)
math(EXPR last "${count}-1")
foreach(index RANGE ${last})
  string(JSON name MEMBER "${facts}" constants ${index})
  string(JSON value GET "${facts}" constants "${name}")
  string(FIND "${header}" "${name}" declared)
  string(FIND "${docs}" "softline.${value}" documented)
  if(declared EQUAL -1 OR documented EQUAL -1)
    message(FATAL_ERROR "Missing public Lua constant declaration/doc: ${name}")
  endif()
endforeach()
string(JSON abi GET "${facts}" abi)
string(FIND "${readme}" "SOFTLINE_ABI_VERSION=${abi}" documented)
if(documented EQUAL -1)
  message(FATAL_ERROR "ABI documentation and implementation differ")
endif()
message(STATUS "Public C exports, receiver/Lua parity and documentation passed")
