cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/header-doxygen.cmake")
file(READ "${ROOT}/lua/README.md" docs)
file(READ "${ROOT}/README.md" readme)
file(READ "${ROOT}/include/softline/softline.h" header)
file(READ "${ROOT}/lua/softline_lua.c" binding)
file(STRINGS "${ROOT}/cmake/softline.exports" exports)
list(FILTER exports EXCLUDE REGEX "^(#|[ \t]*$)")
# Inspect the selected sources during the check, without generated test facts.
string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" code "${header}")
string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" binding "${binding}")
function(section text start end output)
  string(FIND "${text}" "${start}" begin)
  if(begin EQUAL -1)
    message(FATAL_ERROR "Missing API section: ${start}")
  endif()
  string(SUBSTRING "${text}" ${begin} -1 tail)
  string(FIND "${tail}" "${end}" length)
  if(length EQUAL -1)
    message(FATAL_ERROR "Unterminated API section: ${start}")
  endif()
  string(SUBSTRING "${tail}" 0 ${length} body)
  set(${output} "${body}" PARENT_SCOPE)
endfunction()
function(api_names text pattern capture output)
  string(REGEX MATCHALL "${pattern}" matches "${text}")
  set(values)
  foreach(match IN LISTS matches)
    string(REGEX MATCH "${pattern}" unused "${match}")
    list(APPEND values "${CMAKE_MATCH_${capture}}")
  endforeach()
  if(NOT values)
    message(FATAL_ERROR "Empty API declarations: ${output}")
  endif()
  set(${output} "${values}" PARENT_SCOPE)
endfunction()
api_names("${code}" "(sl_[a-z0-9_]+)[ \t\r\n]*\\([^;{}]*\\)" 1 functions)
list(FILTER functions EXCLUDE REGEX "_t$")
list(REMOVE_DUPLICATES functions)
list(SORT functions)
list(SORT exports)
if(NOT functions STREQUAL exports)
  message(FATAL_ERROR "C public declarations and dynamic export allowlist differ")
endif()
section("${code}" "typedef struct sl_config {" "} sl_config_t;" config_code)
api_names("${config_code}"
  "[\n][ \t]*(int|size_t|char|sl_prompt_theme_t|const char[ \t]*\\*)[ \t]*([a-z][a-z0-9_]*)"
  2 config)
section("${binding}" "static void softline_lua_config(" "\n}\n" parser)
api_names("${parser}" "lua_getfield\\(L,[ \t\r\n]*index,[ \t\r\n]*\"([a-z][a-z0-9_]*)\"" 1 lua_config)
list(REMOVE_DUPLICATES lua_config)
section("${binding}" "softline_lua_config_fields[] = {" "};" accepted_code)
api_names("${accepted_code}" "\"([a-z][a-z0-9_]*)\"" 1 accepted)
list(SORT config)
list(SORT lua_config)
list(SORT accepted)
if(NOT config STREQUAL lua_config OR NOT config STREQUAL accepted)
  message(FATAL_ERROR "C and Lua configuration fields differ")
endif()
foreach(field IN LISTS config)
  string(FIND "${docs}" "`${field}`" documented)
  if(documented EQUAL -1)
    message(FATAL_ERROR "Lua config documentation missing: ${field}")
  endif()
endforeach()
section("${binding}" "static const luaL_Reg softline_lua_methods[] = {" "{NULL, NULL}" registry)
api_names("${registry}" "\\{\"([a-z][a-z0-9_]*)\",[ \t\r\n]*softline_lua_[a-z0-9_]+\\}" 1 methods)
foreach(method IN LISTS methods)
  string(FIND "${docs}" "`sl:${method}(" documented)
  if(documented EQUAL -1)
    message(FATAL_ERROR "Lua method documentation missing: ${method}")
  endif()
endforeach()
section("${code}" "struct sl {" "\n};" receiver_code)
api_names("${receiver_code}" "\\(\\*([a-z][a-z0-9_]*)\\)[ \t\r\n]*\\(" 1 receiver)
set(aliases destroy close prompt_queue_count queue_count prompt_queue_capacity queue_capacity
  prompt_queue_peek queue_peek prompt_queue_insert queue_insert prompt_queue_append queue_append
  prompt_queue_replace queue_replace prompt_queue_take queue_take prompt_queue_get_mode queue_mode
  prompt_queue_set_mode queue_set_mode prompt_queue_clear queue_clear prompt_queue_enqueue_draft queue_draft
  set_prompt_queue_delivery set_queue_delivery get_prompt_queue_delivery queue_delivery
  set_prompt_queue_profile set_queue_profile get_prompt_queue_profile queue_profile
  set_prompt_queue_keys set_queue_keys get_prompt_queue_keys queue_keys)
set(expected)
foreach(method IN LISTS receiver)
  if(method STREQUAL free_string)
    continue()
  endif()
  set(lua_name "${method}")
  list(FIND aliases "${method}" alias_index)
  if(NOT alias_index EQUAL -1)
    math(EXPR alias_index "${alias_index}+1")
    list(GET aliases ${alias_index} lua_name)
  endif()
  list(APPEND expected "${lua_name}")
  if(NOT "sl_${method}" IN_LIST functions)
    message(FATAL_ERROR "Receiver lacks public C counterpart: ${method}")
  endif()
endforeach()
list(SORT expected)
list(SORT methods)
if(NOT expected STREQUAL methods)
  message(FATAL_ERROR "C receiver and Lua method registry differ")
endif()
# CMake match results are lists; normalize statement separators first.
string(REPLACE ";" "\n" constant_code "${binding}")
set(constant_pattern "lua_pushinteger\\(L,[ \t\r\n]*(SL_[A-Z0-9_]+)\\)[ \t\r\n]+lua_setfield\\(L, -2, \"([A-Z0-9_]+)\"\\)")
string(REGEX MATCHALL "${constant_pattern}" constants "${constant_code}")
if(NOT constants)
  message(FATAL_ERROR "Empty Lua constant registrations")
endif()
foreach(constant IN LISTS constants)
  string(REGEX MATCH "${constant_pattern}" unused "${constant}")
  set(name "${CMAKE_MATCH_1}")
  set(value "${CMAKE_MATCH_2}")
  string(FIND "${header}" "${name}" declared)
  string(FIND "${docs}" "softline.${value}" documented)
  if(declared EQUAL -1 OR documented EQUAL -1)
    message(FATAL_ERROR "Missing public Lua constant declaration/doc: ${name}")
  endif()
endforeach()
file(READ "${ROOT}/CMakeLists.txt" cmake)
if(NOT cmake MATCHES "set\\(SOFTLINE_ABI_VERSION \"([0-9]+)\"")
  message(FATAL_ERROR "Missing shared-library ABI declaration")
endif()
set(abi "${CMAKE_MATCH_1}")
string(FIND "${readme}" "SOFTLINE_ABI_VERSION=${abi}" documented)
if(documented EQUAL -1)
  message(FATAL_ERROR "ABI documentation and implementation differ")
endif()
message(STATUS "Public C exports, receiver/Lua parity and documentation passed")
