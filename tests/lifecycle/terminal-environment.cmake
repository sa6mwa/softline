cmake_minimum_required(VERSION 3.24)
# Ordinary reconfiguration must retain the prepared terminal runtime. CTest owns
# the selected execution; this check compares its native inventory before/after.
set(clean_env "${CMAKE_COMMAND}" -E env)
foreach(name SOFTLINE_TERMINAL_TEST_ROOT CMAKE_LIBRARY_PATH LD_LIBRARY_PATH
    FONTCONFIG_PATH FONTCONFIG_FILE XKB_CONFIG_ROOT NO_AT_BRIDGE TMPDIR)
  list(APPEND clean_env "--unset=${name}")
endforeach()
list(APPEND clean_env "PATH=/usr/bin:/bin")
function(inventory output)
  execute_process(COMMAND ${clean_env} "${CTEST}" --test-dir "${BUILD}" --show-only=json-v1
    RESULT_VARIABLE status OUTPUT_VARIABLE json ERROR_VARIABLE errors)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inspect terminal inventory: ${errors}")
  endif()
  set("${output}" "${json}" PARENT_SCOPE)
endfunction()
inventory(before)
execute_process(COMMAND ${clean_env} "${CMAKE_COMMAND}" -S "${ROOT}" -B "${BUILD}"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Unprepared configure failed: ${output}${errors}")
endif()
execute_process(COMMAND ${clean_env} "${CTEST}" --test-dir "${BUILD}" --stop-on-failure
  --output-on-failure --no-tests=error -j 1 -R "^softline_terminal_tab_expansion$"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT output MATCHES "1/1 Test")
  message(FATAL_ERROR "Unprepared terminal execution failed: ${output}${errors}")
endif()
inventory(after)
string(JSON before_count LENGTH "${before}" tests)
string(JSON after_count LENGTH "${after}" tests)
if(NOT before_count EQUAL after_count OR before_count EQUAL 0)
  message(FATAL_ERROR "Terminal inventory size changed")
endif()
math(EXPR last "${before_count} - 1")
set(found FALSE)
foreach(index RANGE 0 ${last})
  string(JSON prior GET "${before}" tests ${index})
  string(JSON current GET "${after}" tests ${index})
  string(JSON name GET "${prior}" name)
  string(JSON current_name GET "${current}" name)
  if(NOT name STREQUAL current_name)
    message(FATAL_ERROR "Terminal inventory changed: ${name} -> ${current_name}")
  endif()
  if(name STREQUAL "softline_terminal_test_environment")
    set(found TRUE)
  endif()
  if(prior MATCHES "terminal-test-runtime[.]sh" AND NOT prior STREQUAL current)
    message(FATAL_ERROR "Prepared runtime changed for ${name}")
  endif()
endforeach()
if(NOT found)
  message(FATAL_ERROR "Prepared runtime test is absent")
endif()
