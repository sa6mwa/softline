cmake_minimum_required(VERSION 3.24)
set(vendor "${ROOT}/vendor/c-ares")
file(READ "${vendor}/provenance.json" manifest)
string(JSON version GET "${manifest}" version)
string(JSON digest GET "${manifest}" sha256)
if(NOT version STREQUAL "1.34.8" OR NOT digest STREQUAL
    "c222b6d681096f9444d2c4863d2c1174019e27cacca0a4a5c114d36dd7d7bf78")
  message(FATAL_ERROR "Unexpected vendored c-ares identity")
endif()
string(JSON count LENGTH "${manifest}" files)
math(EXPR last "${count}-1")
set(expected provenance.json softline.patch README.softline.md LICENSE.BSD-3-Clause)
foreach(index RANGE ${last})
  string(JSON name MEMBER "${manifest}" files ${index})
  string(JSON hash GET "${manifest}" files "${name}")
  file(SHA256 "${vendor}/${name}" actual)
  if(NOT actual STREQUAL hash)
    message(FATAL_ERROR "Vendored source checksum mismatch: ${name}")
  endif()
  list(APPEND expected "${name}")
endforeach()
file(GLOB_RECURSE actual LIST_DIRECTORIES FALSE RELATIVE "${vendor}" "${vendor}/*")
list(SORT actual)
list(SORT expected)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Vendored source inventory mismatch")
endif()
foreach(license LICENSE.md LICENSE.BSD-3-Clause)
  file(READ "${vendor}/${license}" text)
  if(NOT text MATCHES "MIT License|SPDX-License-Identifier: BSD-3-Clause")
    message(FATAL_ERROR "Missing vendored license: ${license}")
  endif()
endforeach()
message(STATUS "Vendored resolver identity, inventory and checksums passed")
