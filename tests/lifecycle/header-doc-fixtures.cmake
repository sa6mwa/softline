cmake_minimum_required(VERSION 3.24)
set(work "${ROOT}/build/host-tests/header-doc-fixture")
file(REMOVE_RECURSE "${work}")
foreach(relative include/softline/softline.h cmake/softline_version.h.in
    cmake/softline.exports lua/softline_lua.c lua/README.md README.md CMakeLists.txt)
  get_filename_component(directory "${work}/${relative}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}")
  file(COPY_FILE "${ROOT}/${relative}" "${work}/${relative}")
endforeach()
file(READ "${ROOT}/include/softline/softline.h" header)
file(READ "${ROOT}/cmake/softline_version.h.in" version)
function(check name expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${work}"
    -P "${ROOT}/tests/lifecycle/public-api.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  string(REGEX REPLACE "[ \t\r\n]+" " " diagnostic "${error}")
  if(expected STREQUAL "")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "${name}: valid documentation rejected: ${output}${error}")
    endif()
  elseif(result EQUAL 0 OR NOT diagnostic MATCHES "missing Doxygen comment" OR
      NOT diagnostic MATCHES "${expected}")
    message(FATAL_ERROR "${name}: expected attached-documentation rejection: ${output}${error}")
  endif()
endfunction()
check(original "")
string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" stripped "${header}")
file(WRITE "${work}/include/softline/softline.h" "${stripped}")
check(all_comments_removed sl_t)
string(REPLACE "/** Receiver handle" "/* Receiver handle" modified "${header}")
file(WRITE "${work}/include/softline/softline.h" "${modified}")
check(ordinary_comment sl_t)
string(REPLACE "typedef struct sl sl_t;" "#define DOC_SEPARATOR 1\ntypedef struct sl sl_t;" modified "${header}")
file(WRITE "${work}/include/softline/softline.h" "${modified}")
check(detached_comment sl_t)
function(missing_doc declaration expected)
  string(REGEX REPLACE "/\\*\\*([^*]|\\*+[^*/])*\\*+/[ \t\r\n]+(${declaration})"
    "\\2" modified "${header}")
  if(modified STREQUAL header)
    message(FATAL_ERROR "Could not prepare documentation fixture: ${declaration}")
  endif()
  file(WRITE "${work}/include/softline/softline.h" "${modified}")
  check("missing_${expected}" "${expected}")
endfunction()
missing_doc("typedef int \\(\\*sl_watch_callback_t\\)" sl_watch_callback_t)
missing_doc("typedef enum sl_watch_events" sl_watch_events)
missing_doc("SL_WATCH_READ =" SL_WATCH_READ)
missing_doc("sl_watch_id_t id;" "sl_watch_id_t id")
missing_doc("struct sl \\{" "struct sl")
missing_doc("void \\*impl;" impl)
missing_doc("int sl_output_stream_begin\\(" sl_output_stream_begin)
missing_doc("#define SL_STATUS_MAX_ELEMENTS" SL_STATUS_MAX_ELEMENTS)
string(REPLACE "/** Receiver handle for one independent softline editor instance. */"
  "/// Receiver handle for one independent softline editor instance."
  modified "${header}")
file(WRITE "${work}/include/softline/softline.h" "${modified}")
check(line_doxygen "")
file(WRITE "${work}/include/softline/softline.h" "${header}")
string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" stripped "${version}")
file(WRITE "${work}/cmake/softline_version.h.in" "${stripped}")
check(version_comments_removed "cmake/softline_version[.]h[.]in")
file(REMOVE_RECURSE "${work}")
message(STATUS "Attached Doxygen checks reject missing, ordinary and detached comments across public declarations")
