cmake_minimum_required(VERSION 3.24)
file(READ "${ROOT}/CMakePresets.json" presets)
foreach(kind configure build test)
  string(JSON count LENGTH "${presets}" "${kind}Presets")
  math(EXPR last "${count}-1")
  set(names)
  foreach(index RANGE ${last})
    string(JSON name GET "${presets}" "${kind}Presets" ${index} name)
    list(APPEND names "${name}")
    if(kind STREQUAL "configure" AND name MATCHES "^(.*)-release$")
      set(target "${CMAKE_MATCH_1}")
      string(JSON identity GET "${presets}" configurePresets ${index} cacheVariables SL_TARGET_ID)
      if(NOT identity STREQUAL target)
        message(FATAL_ERROR "${name}: incorrect target identity")
      endif()
      foreach(key SL_DIST_DIR CMAKE_INSTALL_PREFIX)
        string(JSON value GET "${presets}" configurePresets ${index} cacheVariables "${key}")
      endforeach()
    endif()
  endforeach()
  foreach(required debug asan valgrind fuzz)
    if(NOT required IN_LIST names)
      message(FATAL_ERROR "Missing ${kind} preset: ${required}")
    endif()
  endforeach()
  if(NOT kind STREQUAL "test")
    foreach(target x86_64-linux-gnu x86_64-linux-musl aarch64-linux-gnu
        aarch64-linux-musl armhf-linux-gnu armhf-linux-musl arm64-apple-darwin)
      if(NOT "${target}-release" IN_LIST names)
        message(FATAL_ERROR "Missing ${kind} release preset: ${target}")
      endif()
    endforeach()
  endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" --list-presets=all
  WORKING_DIRECTORY "${ROOT}" RESULT_VARIABLE result OUTPUT_VARIABLE listing)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "CMake could not load the declared presets: ${listing}")
endif()
message(STATUS "Native CMake preset inventory passed")
