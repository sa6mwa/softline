package = "softline"
version = "@VERSION@-1"
rockspec_format = "3.0"
source = {
   url = "@SOURCE_URL@",
   dir = "@SOURCE_DIR@",
}
description = {
   summary = "Lua facade for the softline multiline prompt editor",
   detailed = [[
      softline is a C89/POSIX multiline prompt editor. This rock provides a
      thin Lua 5.5 C module facade over the installed libsoftline public API.
   ]],
   homepage = "https://github.com/pkt-c/softline",
   license = "MIT",
}
build = {
   type = "command",
   build_command = [[./scripts/build_lua_rock.sh "$(CC)" "$(CFLAGS)" "$(LIBFLAG)" "$(OBJ_EXTENSION)" "$(LIB_EXTENSION)" "$(LUA_INCDIR)"]],
   install_command = [[mkdir -p "$(LIBDIR)" && cp build/lua-rock/softline.$(LIB_EXTENSION) "$(LIBDIR)/softline.$(LIB_EXTENSION)"]],
}
